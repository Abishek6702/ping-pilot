# PingPilot Backend Environment Configuration
NODE_ENV=development
PORT=5000

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pingpilot?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Frontend CORS Origin URL
FRONTEND_URL=http://localhost:5173

# Google OAuth Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Admin Email (Only this email has administrative access to this personal instance)
ADMIN_EMAIL=admin@example.com

# Initial password generated for first-time admin bootstrap
ADMIN_INITIAL_PASSWORD=ChangeThisPasswordInProduction!2026

# Internal Worker Secret for GitHub Actions / Cron triggers
PINGPILOT_WORKER_SECRET=generate_a_secure_random_hex_string_for_worker_auth

# Cookie Domain (Leave empty in local development, set to your backend domain or top domain in production if needed)
COOKIE_DOMAIN=

